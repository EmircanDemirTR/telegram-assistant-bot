{
  "name": "telegram-assistant-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kişisel Telegram Asistan Botu: Hava Durumu, Güncel Haberler, Teknoloji Bültenleri ve AI Sohbet.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "fast-xml-parser": "^5.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
