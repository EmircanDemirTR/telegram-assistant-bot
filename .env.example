# ==========================================
# 🤖 Telegram Asistan Botu Yapılandırması
# ==========================================
# Bu dosyayı ".env" adıyla kopyalayıp (cp .env.example .env) değerleri kendinize göre doldurun.
# Değerleri olduğu gibi yapıştırın: "=" işaretinin etrafında boşluk bırakmayın.
# ⚠️ .env dosyanız gizlidir: kimseyle paylaşmayın, GitHub'a yüklemeyin.

# 1. ZORUNLU: Telegram Bot Token (BotFather'dan alınır)
# Örnek: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. ZORUNLU: Telegram Chat ID'niz (yalnızca rakamlar)
# Bot yalnızca bu sohbete yanıt verir ve sabah/akşam bültenlerini buraya gönderir.
# Öğrenmek için Telegram'da @userinfobot'a mesaj atın; size "Id: 123456789" yazar.
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. İSTEĞE BAĞLI: Yapay Zeka (AI) Asistanı için OpenRouter API Anahtarı
# Boş bırakırsanız hava durumu ve haber komutları yine çalışır; serbest sohbet ve
# yapay zekalı haber özeti için gereklidir.
# Anahtar oluşturmak ücretsizdir ama modeller kullanım başına ücretlidir:
# OpenRouter hesabınıza kredi yüklemeniz gerekir. https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Yapay zeka modeli (varsayılan: Google Gemini 3.8 Flash).
# Sohbet "HTTP 404" hatası verirse model kaldırılmış olabilir; güncel adı https://openrouter.ai/models adresinden bulun.
OPENROUTER_MODEL=google/gemini-3.8-flash

# 4. İSTEĞE BAĞLI: Konum ve Zaman Ayarları
# Koordinatlarda ondalık ayırıcı NOKTA olmalıdır (39.9334). Google Haritalar'da konuma
# sağ tıklayıp koordinatları kopyalayabilirsiniz (ilk sayı LATITUDE, ikincisi LONGITUDE).
LOCATION_NAME="İstanbul"
LATITUDE=41.0082
LONGITUDE=28.9784
TIMEZONE="Europe/Istanbul"
LOG_LEVEL="info"
