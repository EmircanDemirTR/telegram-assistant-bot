# ==========================================
# 🤖 Telegram Asistan Botu Yapılandırması
# ==========================================

# 1. ZORUNLU: Telegram Bot Token (BotFather'dan alınır)
# Örnek: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. ÖNERİLEN: Botun yalnızca size yanıt vermesi için Telegram Chat ID'niz
# (Öğrenmek için Telegram'da @userinfobot veya @myidbot'a mesaj atabilirsiniz)
TELEGRAM_CHAT_ID=your_chat_id_here

# 3. İSTEĞE BAĞLI: Yapay Zeka (AI) Asistanı için OpenRouter API Anahtarı
# Boş bırakırsanız hava durumu ve haber komutları yine çalışır; serbest sohbet için gereklidir.
# https://openrouter.ai/settings/keys adresinden ücretsiz/ücretli alabilirsiniz.
OPENROUTER_API_KEY=

# Yapay zeka modeli (varsayılan: Google Gemini 2.0 Flash)
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# 4. İSTEĞE BAĞLI: Konum ve Zaman Ayarları
LOCATION_NAME="İstanbul"
LATITUDE=41.0082
LONGITUDE=28.9784
TIMEZONE="Europe/Istanbul"
LOG_LEVEL="info"
